{
  "ConnectionStrings": {
    "MongoDB": "mongodb://localhost:27017"
  },
  "OxQL": {
    "DatabaseName": "oxql_sample",
    "Limits": {
      "MaxPageSize": 500,
      "DefaultPageSize": 100
    },
    "Explain": { "Enabled": true },
    "Compat": { "Enabled": true },
    "Cursor": { "SigningKey": "sample-only-change-me" }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
