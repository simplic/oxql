{
  "entityType": "ledger.transaction",
  "variables": {
    "transactionId": "7d0e4c1a-3b9e-4d55-9a57-3f1f1b0f2c11"
  },
  "strict": true,
  "pipeline": [
    {
      "match": {
        "id": {
          "eq": {
            "$var": "transactionId"
          }
        }
      }
    },
    {
      "resolve": {
        "path": "createUserId",
        "as": "clerk",
        "onMissing": "null"
      }
    },
    {
      "unwind": {
        "path": "items",
        "flatten": "items",
        "as": "item",
        "includeIndex": "position"
      }
    },
    {
      "match": {
        "item": {
          "is": "BillingLineTransactionItem"
        }
      }
    },
    {
      "resolve": {
        "path": "item.references.referenceId",
        "as": "lineShipment",
        "elements": "first",
        "target": "transport.shipment"
      }
    },
    {
      "resolve": {
        "path": "lineShipment.tours.tourId",
        "as": "deliveringTour",
        "elements": "first"
      }
    },
    {
      "resolve": {
        "path": "deliveringTour.resource.id",
        "as": "tourVehicle",
        "target": "fleet.vehicle",
        "onMissing": "null"
      }
    },
    {
      "resolve": {
        "path": "deliveringTour.attachedResources.resource.id",
        "as": "driver",
        "elements": "first",
        "target": "staff.employee",
        "onMissing": "null"
      }
    },
    {
      "resolve": {
        "path": "item.references.referenceId",
        "as": "lineTour",
        "elements": "first",
        "target": "transport.tour"
      }
    },
    {
      "project": {
        "number": 1,
        "date": 1,
        "dueDate": 1,
        "invoiceRecipient": 1,
        "termsOfPayment.formattedText": 1,
        "totalPriceNet": 1,
        "totalPriceGross": 1,
        "taxKeyTotalPrices": 1,
        "clerk.id": 1,
        "clerk.address.firstName": 1,
        "clerk.address.lastName": 1,
        "clerk.primaryEmailAddress.email": 1,
        "clerk.userId": 1,
        "position": 1,
        "item.text": 1,
        "item.quantity": 1,
        "item.totalPriceNet": 1,
        "lineShipment.id": 1,
        "lineShipment.shipmentNumber": 1,
        "lineShipment.referenceNumber": 1,
        "lineShipment.loadAddress": 1,
        "lineShipment.deliveryAddress": 1,
        "lineShipment.effectiveDeliveryEnd": 1,
        "lineShipment.deliveryNoteNumber": 1,
        "lineShipment.items.weightNotes.number": 1,
        "lineShipment.items.weightNotes.quantity": 1,
        "deliveringTour.id": 1,
        "deliveringTour.number": 1,
        "tourVehicle.id": 1,
        "tourVehicle.registrationPlate.registrationIdentifier": 1,
        "tourVehicle.matchCode": 1,
        "driver.id": 1,
        "driver.address.firstName": 1,
        "driver.address.lastName": 1,
        "driver.primaryEmailAddress.email": 1,
        "lineTour.id": 1,
        "lineTour.number": 1,
        "lineTour.startDateTime": 1,
        "lineTour.endDateTime": 1,
        "lineTour.actions": 1
      }
    },
    {
      "sort": [
        {
          "position": "asc"
        }
      ]
    },
    {
      "page": {
        "limit": 5000
      }
    }
  ]
}
