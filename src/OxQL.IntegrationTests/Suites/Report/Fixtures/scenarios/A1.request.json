{
  "entityType": "ledger.transaction",
  "variables": {
    "transactionId": "7d0e4c1a-3b9e-4d55-9a57-3f1f1b0f2c11"
  },
  "strict": true,
  "pipeline": [
    {
      "match": {
        "id": {
          "eq": {
            "$var": "transactionId"
          }
        }
      }
    },
    {
      "unwind": {
        "path": "items",
        "flatten": "items",
        "as": "item",
        "includeIndex": "position"
      }
    },
    {
      "match": {
        "item": {
          "is": "BillingLineTransactionItem"
        }
      }
    },
    {
      "resolve": {
        "path": "item.billingLineId",
        "as": "erpLine"
      }
    },
    {
      "resolve": {
        "path": "erpLine.sourceBillingLineReference.id",
        "as": "sourceLine",
        "parentAs": "sourceParent"
      }
    },
    {
      "project": {
        "number": 1,
        "date": 1,
        "position": 1,
        "item.text": 1,
        "item.quantity": 1,
        "item.totalPriceNet": 1,
        "erpLine.id": 1,
        "erpLine.text": 1,
        "erpLine.sourceBillingLineReference.type": 1,
        "erpLine.sourceBillingLineReference.id": 1,
        "sourceLine.id": 1,
        "sourceLine.type": 1,
        "sourceLine.status": 1,
        "sourceLine.singlePrice": 1,
        "sourceLine.totalPrice": 1,
        "sourceLine.quantity.value": 1,
        "sourceLine.quantity.quantityUnit": 1,
        "sourceParent.id": 1,
        "sourceParent.shipmentNumber": 1,
        "sourceParent.referenceNumber": 1,
        "sourceParent.number": 1
      }
    },
    {
      "sort": [
        {
          "position": "asc"
        }
      ]
    },
    {
      "page": {
        "limit": 5000
      }
    }
  ]
}
